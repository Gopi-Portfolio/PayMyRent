# Copy to .env for local runs. Every secret below MUST be replaced outside local/test.
RG_APP_ENV=local
RG_DATABASE_URL=postgresql+psycopg://paymyrent:paymyrent@localhost:5432/paymyrent
RG_PUBLIC_BASE_URL=http://localhost:8000
RG_CORS_ORIGINS=["http://localhost:8081"]

# Auth: Firebase Phone Auth in staging/production; dev OTP simulator only locally
RG_FIREBASE_PROJECT_ID=
RG_DEV_AUTH_ENABLED=true
RG_DEV_JWT_SECRET=dev-only-not-a-secret
RG_OTP_HASH_SECRET=dev-otp-hash-key

# Payments — two separate merchant configurations (platform subscription vs owner rent)
RG_SUBSCRIPTION_PROVIDER=sandbox
RG_SUBSCRIPTION_KEY_ID=
RG_SUBSCRIPTION_KEY_SECRET=
RG_SUBSCRIPTION_WEBHOOK_SECRET=sandbox-sub-webhook-secret
RG_RENT_PROVIDER=sandbox
RG_RENT_KEY_ID=
RG_RENT_KEY_SECRET=
RG_RENT_WEBHOOK_SECRET=sandbox-rent-webhook-secret
RG_GRACE_DAYS=7

# Messaging: console | ses (email). SMS/WhatsApp/FCM adapters need provider accounts.
RG_SMS_PROVIDER=console
RG_WHATSAPP_PROVIDER=console
RG_EMAIL_PROVIDER=console
RG_PUSH_PROVIDER=console

# AI: mock | bedrock
RG_AI_PROVIDER=mock
RG_AI_ENABLED=true

# Storage: local | s3
RG_STORAGE_BACKEND=local
RG_S3_BUCKET=
RG_AWS_REGION=ap-south-1

RG_JOB_TRIGGER_SECRET=dev-job-secret

RG_FILE_SIGNING_SECRET=dev-file-signing-key
RG_PAN_ENCRYPTION_KEY=dev-pan-encryption-key

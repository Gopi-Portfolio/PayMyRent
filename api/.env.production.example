# Copy outside git, fill every value, and pass with API_ENV_FILE. The API refuses to start if any of these are unsafe.
RG_APP_ENV=production
RG_PUBLIC_BASE_URL=https://api.example.in
RG_ALLOWED_HOSTS=["api.example.in"]
RG_CORS_ORIGINS=[]
RG_DEV_AUTH_ENABLED=false
RG_FIREBASE_PROJECT_ID=your-firebase-project
# Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# The API's signed-in requests use a LIMITED database role (pmr_app) under row-level security. Set its password in the compose
# environment as APP_DB_PASSWORD (generate like the secrets below); the API refuses to start in production without it.
RG_DEV_JWT_SECRET=
RG_OTP_HASH_SECRET=
RG_JOB_TRIGGER_SECRET=
RG_FILE_SIGNING_SECRET=
RG_PAN_ENCRYPTION_KEY=            # keep a backup: losing it makes stored PANs unreadable
RG_ADMIN_TOKEN=
RG_SUBSCRIPTION_PROVIDER=razorpay
RG_SUBSCRIPTION_KEY_ID=
RG_SUBSCRIPTION_KEY_SECRET=
RG_SUBSCRIPTION_WEBHOOK_SECRET=
RG_RENT_PROVIDER=razorpay
RG_RENT_KEY_ID=
RG_RENT_KEY_SECRET=
RG_RENT_WEBHOOK_SECRET=
RG_KYC_WEBHOOK_SECRET=
RG_AI_PROVIDER=bedrock
RG_STORAGE_BACKEND=s3
RG_S3_BUCKET=
RG_AWS_REGION=ap-south-1

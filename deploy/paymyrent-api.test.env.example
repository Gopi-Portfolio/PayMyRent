# API settings for the PRIVATE TEST server (APP_ENV=test in paymyrent.env). Copy to /opt/paymyrent/paymyrent-api.env ON THE SERVER, fill it, chmod 600.
# Generate each secret:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"   (a different one for each line)
# Money is fake (sandbox) and the photo-ID check is the sandbox page, but LOGIN is a real Firebase token.
RG_PUBLIC_BASE_URL=https://161-153-65-47.sslip.io
RG_ALLOWED_HOSTS=["161-153-65-47.sslip.io"]
RG_CORS_ORIGINS=[]
RG_DEV_AUTH_ENABLED=false
RG_FIREBASE_PROJECT_ID=paymyrent-f45cd

RG_DEV_JWT_SECRET=
RG_OTP_HASH_SECRET=
RG_JOB_TRIGGER_SECRET=
RG_FILE_SIGNING_SECRET=
RG_PAN_ENCRYPTION_KEY=
RG_ADMIN_TOKEN=

# Automatic owner document check (PAN card + live selfie + deed pages, read and compared by the server itself, no person involved).
# true = the server may verify an owner and a property by itself when the checks pass (docs/DECISIONS.md D-21). Tune from real photos:
# RG_DOC_FACE_MIN (selfie vs PAN photo, 0..1, higher = stricter), RG_DOC_NAME_MIN (share of the name that must be found), RG_DOC_MAX_TRIES_PER_DAY.
RG_DOC_AUTO_APPROVE=true
# false = no extra one-time codes after login (payout account, co-owner, transfer). TEST SERVER ONLY: set true before real users (D-22).
RG_ACTION_CODES_REQUIRED=false
RG_DOC_FACE_MIN=0.30

# RENT is paid by direct UPI (the app opens GPay/PhonePe, the tenant reports the UTR, the owner confirms): that is REAL money and needs no gateway.
# The sandbox online-rent checkout is switched OFF so no fake rent payment can appear.
RG_RENT_ONLINE_ENABLED=false
# The owner's PLAN fee (subscription) is the only thing that needs a payment gateway. Until Razorpay/Cashfree is connected it stays sandbox,
# which means plans activate without real money. Fine for private testing; production refuses it.
RG_SUBSCRIPTION_PROVIDER=sandbox
RG_RENT_PROVIDER=sandbox
RG_SUBSCRIPTION_WEBHOOK_SECRET=sandbox-sub-webhook-secret
RG_RENT_WEBHOOK_SECRET=sandbox-rent-webhook-secret
RG_KYC_WEBHOOK_SECRET=sandbox-kyc-webhook-secret

RG_AI_ENABLED=false
RG_AI_PROVIDER=mock
RG_STORAGE_BACKEND=local

# Copy to /opt/paymyrent/paymyrent.env ON THE SERVER and fill it. chmod 600. Never commit the filled file.
# Generate each password:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
DB_USER=paymyrent_owner
DB_PASSWORD=
APP_DB_PASSWORD=
DB_NAME=paymyrent
# The address the app calls. A domain you own (A record -> the server IP), or <ip-with-dashes>.sslip.io for testing.
API_DOMAIN=129-146-5-114.sslip.io
# Path of the API settings file (copy of api/.env.production.example, filled in)
API_ENV_FILE=/opt/paymyrent/paymyrent-api.env

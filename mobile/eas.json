{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_AUTH_MODE": "firebase" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_AUTH_MODE": "firebase" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_AUTH_MODE": "firebase" }
    }
  },
  "submit": { "production": {} }
}
